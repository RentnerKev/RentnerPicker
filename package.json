{
    "name": "@rentnerkev/picker",
    "version": "2.0.2",
    "description": "A controlled, accessible React color picker with presets and validation.",
    "author": "RentnerKev",
    "license": "MIT",
    "workspaces": [
        "playground"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "files": [
        "dist",
        "tailwind.css"
    ],
    "sideEffects": [
        "./tailwind.css"
    ],
    "scripts": {
        "build": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc",
        "typecheck": "tsc --noEmit && tsc --project tsconfig.type-tests.json",
        "test": "bun test",
        "prepare": "bun run build",
        "pack:check": "bun pm pack --dry-run",
        "test:e2e": "playwright test",
        "playground:dev": "bun --cwd playground dev",
        "playground:build": "bun --cwd playground build",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "verify": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build && bun run pack:check && bun run test:e2e"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RentnerKev/RentnerPicker.git"
    },
    "homepage": "https://github.com/RentnerKev/RentnerPicker#readme",
    "bugs": {
        "url": "https://github.com/RentnerKev/RentnerPicker/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "dependencies": {
        "lucide-react": "^1.47.0"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@happy-dom/global-registrator": "^20.14.5",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.0.5",
        "happy-dom": "^20.14.5",
        "oxfmt": "^0.68.0",
        "oxlint": "^1.78.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.2.1"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./tailwind.css": "./tailwind.css",
        "./picker": {
            "import": "./dist/Components/CustomColorPicker.js",
            "types": "./dist/Components/CustomColorPicker.d.ts"
        },
        "./color": {
            "import": "./dist/color.js",
            "types": "./dist/color.d.ts"
        },
        "./messages": {
            "import": "./dist/i18n.js",
            "types": "./dist/i18n.d.ts"
        },
        "./types": {
            "import": "./dist/types.js",
            "types": "./dist/types.d.ts"
        },
        "./package.json": "./package.json"
    },
    "packageManager": "bun@1.4.2"
}
