{
    "name": "@rentnerkev/picker",
    "version": "2.1.7",
    "description": "A controlled, accessible React color picker with presets and validation.",
    "author": "RentnerKev",
    "license": "MIT",
    "workspaces": [
        "playground"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "files": [
        "dist",
        "tailwind.css",
        "README.md",
        "docs/usage.md"
    ],
    "sideEffects": [
        "./tailwind.css"
    ],
    "scripts": {
        "build": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc",
        "typecheck": "tsc --noEmit && tsc --project tsconfig.type-tests.json && bun run typecheck:playground && bun run typecheck:automation",
        "test": "bun test",
        "prepare": "bun run build",
        "pack:check": "bun pm pack --dry-run",
        "pack:consumer": "node scripts/consumer/verify.mjs",
        "test:e2e": "playwright test",
        "playground:dev": "bun --cwd playground dev",
        "playground:build": "bun --cwd playground build",
        "lint": "oxlint --deny-warnings src scripts playground/src playground/vite.config.ts playwright.config.ts .github/scripts",
        "lint:fix": "oxlint --fix --deny-warnings src scripts playground/src playground/vite.config.ts playwright.config.ts .github/scripts",
        "format": "oxfmt src scripts playground/src .github/scripts docs README.md package.json tsconfig.json tsconfig.type-tests.json playground/tsconfig.json playground/package.json playground/vite.config.ts playwright.config.ts .oxlintrc.json .oxfmtrc.json",
        "format:check": "oxfmt --check src scripts playground/src .github/scripts docs README.md package.json tsconfig.json tsconfig.type-tests.json playground/tsconfig.json playground/package.json playground/vite.config.ts playwright.config.ts .oxlintrc.json .oxfmtrc.json",
        "verify": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build && bun run pack:check && bun run pack:consumer && bun run test:e2e",
        "typecheck:automation": "tsc --noEmit -p .github/scripts/tsconfig.json",
        "typecheck:playground": "tsc --noEmit -p playground/tsconfig.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RentnerKev/RentnerPicker.git"
    },
    "homepage": "https://packages.rentner.dev/packages/color-picker",
    "bugs": {
        "url": "https://github.com/RentnerKev/RentnerPicker/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "dependencies": {
        "lucide-react": "^1.52.0"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@happy-dom/global-registrator": "^20.14.5",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/bun": "^1.4.2",
        "@types/node": "^24.19.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "happy-dom": "^20.14.5",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.3"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./tailwind.css": "./tailwind.css",
        "./picker": {
            "import": "./dist/shared/Picker/Components/CustomColorPicker.js",
            "types": "./dist/shared/Picker/Components/CustomColorPicker.d.ts"
        },
        "./color": {
            "import": "./dist/lib/Color/color.js",
            "types": "./dist/lib/Color/color.d.ts"
        },
        "./messages": {
            "import": "./dist/lib/Messages/i18n.js",
            "types": "./dist/lib/Messages/i18n.d.ts"
        },
        "./types": {
            "import": "./dist/shared/Picker/Types/picker.types.js",
            "types": "./dist/shared/Picker/Types/picker.types.d.ts"
        },
        "./package.json": "./package.json",
        "./ai": {
            "types": "./dist/ai.d.ts",
            "import": "./dist/ai.js"
        }
    },
    "packageManager": "bun@1.4.2"
}
